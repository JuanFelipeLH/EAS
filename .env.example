# NewsAPI key — get yours free at https://newsapi.org/register
NEWS_API_KEY=your_newsapi_key_here

# NewsData.io key — optional, free 200 req/day at https://newsdata.io/register
NEWSDATA_API_KEY=your_newsdata_key_here

# OpenRouter API key — get yours at https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Optional: override the default model (default: arcee-ai/trinity-large-preview:free)
# OPENROUTER_MODEL=mistralai/mistral-7b-instruct
